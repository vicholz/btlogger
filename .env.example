# Database (compose sets these automatically)
POSTGRES_USER=btlogger
POSTGRES_PASSWORD=btlogger
POSTGRES_DB=btlogger

# Scanner: auto | serial | bleak | replay
# auto: nRF serial firmware if it speaks NDJSON, else host BlueZ, else replay
SCANNER_BACKEND=auto
SERIAL_PORT=/dev/ttyACM0
SERIAL_BAUD=115200
HCI_ADAPTER=

# Coalesce duplicate advertisements from the same device (milliseconds)
SIGHTING_MIN_INTERVAL_MS=1000

# TimescaleDB retention for raw packets/sightings
SIGHTING_RETENTION_DAYS=90

# Web UI / API
API_PORT=8080
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=btlogger
