      "targets": [
        {
          "rawQuery": true,
          "rawSql": "SELECT address, name, device_type, manufacturer_name, visit_count, total_dwell_seconds, last_seen FROM devices ORDER BY total_dwell_seconds DESC LIMIT 30;",
