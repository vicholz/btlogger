          "rawQuery": true,
          "rawSql": "SELECT address, name, device_type, last_rssi, last_seen, visit_count, total_dwell_seconds FROM devices ORDER BY last_seen DESC LIMIT 50;",
          "format": "table",
          "refId": "A"
        }
      ]
