    {
      "id": 5,
      "type": "timeseries",
      "title": "Sightings",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 4 },
      "datasource": { "type": "postgres", "uid": "btlogger-tsdb" },
      "targets": [
        {
          "rawQuery": true,
          "rawSql": "SELECT time_bucket('1 minute', time) AS time, COUNT(*)::int AS sightings FROM sightings WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1;",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Unique devices per minute",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "datasource": { "type": "postgres", "uid": "btlogger-tsdb" },
      "targets": [
        {
          "rawQuery": true,
          "rawSql": "SELECT time_bucket('1 minute', time) AS time, COUNT(DISTINCT device_id)::int AS devices FROM sightings WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1;",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Longest total time seen",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 12 },
